# Copy to deploy/.env and adjust as needed:
#   cp deploy/.env.example deploy/.env
#
# Mongo / Redis 密码须与 app/configs/cluster.configs.yaml 保持一致。

# Published ports on the host
BACKEND_PORT=8989
MONGO_PORT=27017
REDIS_PORT=6379

# MongoDB root（容器首次初始化时创建；须与 cluster.configs.yaml 一致）
MONGO_ROOT_USERNAME=report
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_DB=report-agent-db

# 仅在 --profile redis 启动容器 Redis 时使用；须与 cluster.configs.yaml 中
# redis.password 一致，且不要留空
REDIS_PASSWORD=change-me-redis
